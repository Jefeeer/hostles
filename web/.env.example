# Public URL of the app (used in email links and the Google OAuth redirect).
APP_URL=http://localhost:3000

# Supabase (Project Settings -> API). For local dev, `pnpm supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (optional). OAuth client of type "Web application";
# authorized redirect URI: {APP_URL}/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts the stored refresh token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=

# Resend (optional). Without it, emails are saved to the Outbox page instead of sent.
RESEND_API_KEY=

# Protects /api/cron/daily (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=
